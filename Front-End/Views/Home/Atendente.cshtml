@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Conecta++ - Atendente</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: Arial, sans-serif;
        }

        body {
            display: flex;
            background: #f4f7fb;
            min-height: 100vh;
        }

        .sidebar {
            width: 260px;
            background: #1565d8;
            color: #fff;
            padding: 20px;
            min-height: 100vh;
            flex-shrink: 0;
        }

            .sidebar h2 {
                margin-bottom: 30px;
            }

        .menu-toggle {
            width: 100%;
            padding: 15px;
            margin-top: 10px;
            border: none;
            border-radius: 12px;
            background: #fff;
            color: #1565d8;
            font-size: 16px;
            font-weight: bold;
            cursor: pointer;
            text-align: left;
        }

        .main {
            flex: 1;
            padding: 25px;
            min-width: 0;
        }

        .topbar {
            display: flex;
            justify-content: space-between;
            align-items: center;
            background: #fff;
            padding: 20px;
            border-radius: 14px;
            box-shadow: 0 3px 10px rgba(0,0,0,0.08);
            position: relative;
            overflow: visible;
        }

            .topbar h1 {
                margin: 0;
            }

        .user-area {
            margin-left: auto;
            position: relative;
        }

        .profile-btn {
            background: #1565d8;
            color: #fff;
            border: none;
            padding: 12px 18px;
            border-radius: 10px;
            cursor: pointer;
            font-weight: bold;
            font-size: 16px;
        }

        .dropdown {
            position: absolute;
            top: 58px;
            right: 0;
            left: auto;
            width: 260px;
            background: #fff;
            padding: 20px;
            border-radius: 14px;
            box-shadow: 0 4px 20px rgba(0,0,0,0.15);
            z-index: 2000;
        }

        .hidden {
            display: none !important;
        }

        .logout-btn {
            display: block;
            width: 100%;
            margin-top: 12px;
            padding: 12px;
            border: none;
            border-radius: 8px;
            text-align: center;
            text-decoration: none;
            cursor: pointer;
            background: #ffebeb;
            color: #d63031;
        }

        .section {
            display: none;
            margin-top: 25px;
        }

            .section.active {
                display: block;
            }

        .card {
            background: white;
            padding: 25px;
            border-radius: 14px;
            box-shadow: 0 3px 10px rgba(0,0,0,0.08);
        }

        .table-header {
            margin-bottom: 20px;
        }

        .search-bar input {
            width: 300px;
            max-width: 100%;
            padding: 12px;
            margin-bottom: 20px;
            border: 1px solid #ddd;
            border-radius: 8px;
            outline: none;
        }

        table {
            width: 100%;
            border-collapse: collapse;
            background: white;
        }

        th {
            background: #f4f7fb;
            padding: 15px;
            text-align: left;
        }

        td {
            padding: 15px;
            border-top: 1px solid #eee;
            vertical-align: middle;
        }

        .ativo {
            background: #10b981;
            color: white;
            padding: 6px 12px;
            border-radius: 20px;
            font-size: 13px;
            font-weight: bold;
        }

        .inativo {
            background: #f59e0b;
            color: white;
            padding: 6px 12px;
            border-radius: 20px;
            font-size: 13px;
            font-weight: bold;
        }

        .tipo {
            padding: 6px 12px;
            border-radius: 20px;
            color: white;
            font-size: 13px;
            font-weight: bold;
        }

        .doar {
            background: #7c3aed;
        }

        .receber {
            background: #ec4899;
        }

        .ambos {
            background: #14b8a6;
        }

        .dropdown-actions {
            position: relative;
            display: inline-block;
        }

        .btn-acoes {
            background: #edf4ff;
            border: none;
            padding: 10px 14px;
            border-radius: 10px;
            color: #1565d8;
            font-weight: 700;
            cursor: pointer;
        }

        .actions-menu {
            position: absolute;
            top: 45px;
            right: 0;
            background: white;
            border-radius: 12px;
            width: 180px;
            box-shadow: 0 5px 20px rgba(0,0,0,0.15);
            overflow: hidden;
            z-index: 999;
        }

            .actions-menu button {
                width: 100%;
                border: none;
                background: white;
                padding: 14px;
                text-align: left;
                cursor: pointer;
                font-size: 15px;
            }

                .actions-menu button:hover {
                    background: #f4f7fb;
                }

        .modal {
            position: fixed;
            inset: 0;
            background: rgba(0,0,0,0.45);
            display: flex;
            justify-content: center;
            align-items: center;
            z-index: 9999;
        }

        .modal-content {
            background: white;
            width: 420px;
            max-width: 92vw;
            padding: 30px;
            border-radius: 20px;
            box-shadow: 0 10px 30px rgba(0,0,0,0.15);
        }

            .modal-content h2 {
                margin-bottom: 20px;
            }

            .modal-content input,
            .modal-content select {
                width: 100%;
                padding: 14px;
                border: 1px solid #ddd;
                border-radius: 12px;
                margin-bottom: 20px;
                outline: none;
            }

        .modal-buttons {
            display: flex;
            justify-content: flex-end;
            gap: 12px;
        }

        .btn-cancelar {
            background: #e5e5e5;
            border: none;
            padding: 12px 20px;
            border-radius: 10px;
            cursor: pointer;
        }

        .btn-salvar {
            background: #22c55e;
            color: white;
            border: none;
            padding: 12px 20px;
            border-radius: 10px;
            cursor: pointer;
        }

        .dropdown-btn {
            display: block;
            width: 100%;
            margin-top: 12px;
            padding: 12px;
            border: none;
            border-radius: 8px;
            text-align: center;
            text-decoration: none;
            cursor: pointer;
            background: #edf4ff;
            color: #1565d8;
            font-weight: bold;
        }

        .info {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 16px;
            padding: 18px 0;
            border-bottom: 1px solid #eee;
        }

        .editable {
            min-width: 220px;
        }

        .info button {
            padding: 8px 15px;
            border: none;
            border-radius: 8px;
            background: #edf4ff;
            color: #1565d8;
            cursor: pointer;
            font-weight: 700;
        }

        #perfilAtendente.active,
        #dadosONGAtendente.active {
            display: flex;
            justify-content: center;
            align-items: flex-start;
            width: 100%;
        }

        #perfilAtendente .card,
        #dadosONGAtendente .card {
            width: 700px;
            max-width: 90%;
            margin: 40px auto;
        }

        .modal {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0,0,0,0.3);
            display: flex;
            justify-content: center;
            align-items: center;
            z-index: 9999;
        }

        .modal-content {
            background: white;
            width: 450px;
            padding: 30px;
            border-radius: 20px;
            box-shadow: 0 10px 30px rgba(0,0,0,0.2);
        }

            .modal-content h2 {
                margin-bottom: 25px;
            }

        .modal-buttons {
            margin-top: 25px;
            display: flex;
            justify-content: flex-end;
        }

        .btn-salvar {
            background: #30c95c;
            color: white;
            border: none;
            padding: 12px 22px;
            border-radius: 12px;
            cursor: pointer;
            font-weight: bold;
        }

        .modal {
            z-index: 99999;
        }

        .dropdown {
            z-index: 1;
        }

        .modal {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0,0,0,0.35);
            display: flex;
            justify-content: center;
            align-items: center;
            z-index: 99999;
        }

        .modal-content {
            background: #fff;
            width: 700px;
            max-width: 90%;
            padding: 45px;
            border-radius: 24px;
            box-shadow: 0 15px 40px rgba(0,0,0,0.2);
        }

            .modal-content h2 {
                font-size: 28px;
                margin-bottom: 40px;
            }

        .info {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 22px 0;
            border-bottom: 1px solid #e5e5e5;
            font-size: 20px;
        }

            .info strong {
                font-weight: 700;
            }

        .modal-buttons {
            display: flex;
            justify-content: flex-end;
            margin-top: 35px;
        }

        .btn-salvar {
            background: #19d44f;
            color: white;
            border: none;
            padding: 18px 40px;
            border-radius: 16px;
            font-size: 22px;
            font-weight: bold;
            cursor: pointer;
        }

        #profileDropdown.hidden {
            display: none !important;
        }

    </style>
</head>
<body>

    <aside class="sidebar">
        <h2>Menu</h2>
        <button class="menu-toggle" onclick="showSection('usuarios')">Usuários</button>
        <button class="menu-toggle" onclick="showSection('interesses')">Interesses</button>
    </aside>

    <main class="main">
        <header class="topbar">
            <h1>Painel do Atendente</h1>

            <div class="user-area">
                <button class="profile-btn" onclick="toggleProfile()">
                    Atendente ▼
                </button>

                <div id="profileDropdown" class="dropdown hidden">
                    <strong>Atendente</strong>
                    <p id="atendenteEmailText">atendente@conecta.com</p>

                    <button class="dropdown-btn" onclick="showSection('perfilAtendente')">
                        Perfil
                    </button>

                    <button class="dropdown-btn" onclick="showSection('dadosONGAtendente')">
                        Dados ONG
                    </button>

                    <a href="#" class="logout-btn" onclick="sair(); return false;">
                        Sair
                    </a>
                </div>
            </div>
        </header>

        <section id="usuarios" class="section active">
            <div class="card">
                <div class="table-header">
                    <h2>Usuários cadastrados</h2>
                </div>

                <div class="search-bar">
                    <input type="text" id="searchUsuariosAtendente" placeholder="Pesquisar usuário">
                </div>

                <table>
                    <thead>
                        <tr>
                            <th>Nome</th>
                            <th>CPF</th>
                            <th>Email</th>
                            <th>Telefone</th>
                            <th>Endereço</th>
                            <th>Ações</th>
                        </tr>
                    </thead>
                    <tbody id="listaUsuariosAtendente"></tbody>
                </table>
            </div>
        </section>

        <section id="interesses" class="section">
            <div class="card">
                <div class="table-header">
                    <h2>Interesses</h2>
                </div>

                <div class="search-bar">
                    <input type="text" id="searchInteressesAtendente" placeholder="Pesquisar interesse">
                </div>

                <table>
                    <thead>
                        <tr>
                            <th>Nome do Idoso</th>
                            <th>Tipo Solicitação</th>
                            <th>Descrição</th>
                            <th>Status</th>
                            <th>Data da Solicitação</th>
                            <th>Ações</th>
                        </tr>
                    </thead>

                    <tbody id="listaInteressesAtendente"></tbody>
                </table>
            </div>
        </section>
    </main>

    <div id="modalEditarUsuario" class="modal hidden">
        <div class="modal-content">
            <h2 id="tituloEditarUsuario">Editar</h2>

            <input type="text" id="valorEditarUsuario" placeholder="Novo valor">

            <div class="modal-buttons">
                <button class="btn-cancelar" onclick="fecharModalUsuario()">Cancelar</button>
                <button class="btn-salvar" onclick="salvarEdicaoUsuario()">Salvar</button>
            </div>
        </div>
    </div>

    <div id="modalEditarInteresse" class="modal hidden">
        <div class="modal-content">
            <h2 id="tituloEditarInteresse">Editar</h2>
            <div id="areaEditarInteresse"></div>

            <div class="modal-buttons">
                <button class="btn-cancelar" onclick="fecharModalInteresse()">Cancelar</button>
                <button class="btn-salvar" onclick="salvarEdicaoInteresse()">Salvar</button>
            </div>
        </div>
    </div>
    <section id="perfilAtendente" class="section">
        <div class="modal">
            <div class="modal-content">

                <h2>Informações Pessoais</h2>

                <div class="info">
                    <strong>Nome:</strong>
                    <span>Atendente</span>
                </div>

                <div class="info">
                    <strong>Email:</strong>
                    <span>atendente@gmail.com</span>
                </div>

                <div class="info">
                    <strong>Celular:</strong>
                    <span>1196548264</span>
                </div>

                <div class="modal-buttons">
                    <button class="btn-salvar"
                            onclick="showSection('usuarios')">
                        Fechar
                    </button>
                </div>

            </div>
        </div>
    </section>

    <section id="dadosONGAtendente" class="section">
        <div class="modal">
            <div class="modal-content">

                <h2>Dados da ONG</h2>

                <div class="info">
                    <strong>Nome:</strong>
                    <span>Conecta++</span>
                </div>

                <div class="info">
                    <strong>Telefone:</strong>
                    <span>(11) 91910-0860</span>
                </div>

                <div class="info">
                    <strong>Email:</strong>
                    <span>contato@ong.com</span>
                </div>

                <div class="info">
                    <strong>Endereço:</strong>
                    <span>Rua Gugu, São Paulo SP</span>
                </div>

                <div class="info">
                    <strong>CNPJ:</strong>
                    <span>12345678000199</span>
                </div>

                <div class="modal-buttons">
                    <button class="btn-salvar"
                            onclick="showSection('usuarios')">
                        Fechar
                    </button>
                </div>

            </div>
        </div>
    </section>
    <script>

        function abrirPerfil() {
            document.getElementById("perfilModal").style.display = "flex";
            document.getElementById("profileDropdown").style.display = "none";
        }

        function fecharPerfil() {
            document.getElementById("perfilModal").style.display = "none";
        }

        function abrirDadosONG() {
            document.getElementById("ongModal").style.display = "flex";
            document.getElementById("profileDropdown").style.display = "none";
        }

        function fecharDadosONG() {
            document.getElementById("ongModal").style.display = "none";
        }

                function showSection(sectionId) {
                    document.querySelectorAll('.section').forEach(section => {
                        section.classList.remove('active');
                    });

                    const selected = document.getElementById(sectionId);
                    if (selected) {
                        selected.classList.add('active');
                    }
                }

                function toggleProfile() {
                    const dropdown = document.getElementById("profileDropdown");
                    if (dropdown) {
                        dropdown.classList.toggle("hidden");
                    }
                }

                async function sair() {
                    localStorage.removeItem("tipoUsuario");
                    localStorage.removeItem("atendenteEmail");
                    await fetch("/api/auth/sair", { method: "POST" }).catch(() => null);
                    window.location.href = "/Home/Index";
                }

                function toggleActions(button) {
                    const menu = button.parentElement.querySelector(".actions-menu");
                    if (!menu) return;

                    document.querySelectorAll(".actions-menu").forEach(other => {
                        if (other !== menu) other.classList.add("hidden");
                    });

                    menu.classList.toggle("hidden");
                }

                function textoTipoInteresse(tipo) {
                    const valor = (tipo || "").toLowerCase();

                    if (valor === "doar" || valor === "doador") return "Doador";
                    if (valor === "receber" || valor === "recebedor" || valor === "receptor") return "Recebedor";
                    if (valor === "ambos") return "Ambos";

                    return "Ambos";
                }

                function classeTipoInteresse(tipo) {
                    const valor = textoTipoInteresse(tipo).toLowerCase();

                    if (valor === "doador") return "doar";
                    if (valor === "recebedor") return "receber";

                    return "ambos";
                }

                let usuariosAtendenteBanco = [];
                let interessesAtendenteBanco = [];

                async function carregarUsuariosAtendente() {
                    const tbody = document.getElementById("listaUsuariosAtendente");
                    if (!tbody) return;

                    tbody.innerHTML = "";

                    try {
                        const resposta = await fetch("/api/atendente/usuarios");

                        if (!resposta.ok) {
                            throw new Error("Erro ao carregar usuários.");
                        }

                        usuariosAtendenteBanco = await resposta.json();
                    } catch (erro) {
                        console.error(erro);
                        alert("Erro ao carregar usuários do banco.");
                        return;
                    }

                    usuariosAtendenteBanco.forEach((usuario, index) => {
                        const tr = document.createElement("tr");

                        tr.innerHTML = `
                            <td>${usuario.nome || ""}</td>
                            <td>${usuario.cpf || ""}</td>
                            <td>${usuario.email || ""}</td>
                            <td>${usuario.telefone || ""}</td>
                            <td>${usuario.endereco || ""}</td>
                            <td>
                                <div class="dropdown-actions">
                                    <button class="btn-acoes" type="button" onclick="toggleActions(this)">Ações ▼</button>
                                    <div class="actions-menu hidden">
                                        <button type="button" onclick="abrirModalUsuario('telefone', ${index})">Editar telefone</button>
                                        <button type="button" onclick="abrirModalUsuario('email', ${index})">Editar email</button>
                                        <button type="button" onclick="abrirModalUsuario('endereco', ${index})">Editar endereço</button>
                                    </div>
                                </div>
                            </td>
                        `;

                        tbody.appendChild(tr);
                    });
                }

                function pesquisarUsuariosAtendente() {
                    const input = document.getElementById("searchUsuariosAtendente");
                    const tbody = document.getElementById("listaUsuariosAtendente");

                    if (!input || !tbody) return;

                    input.addEventListener("input", function () {
                        const termo = this.value.toLowerCase();

                        tbody.querySelectorAll("tr").forEach(tr => {
                            tr.style.display = tr.textContent.toLowerCase().includes(termo) ? "" : "none";
                        });
                    });
                }

                async function carregarInteressesAtendente() {
            const tbody = document.getElementById("listaInteressesAtendente");
            if (!tbody) return;

            tbody.innerHTML = "";

            try {
                const resposta = await fetch("/api/atendente/interesses");

                if (!resposta.ok) {
                    throw new Error("Erro ao carregar interesses.");
                }

                interessesAtendenteBanco = await resposta.json();
            } catch (erro) {
                console.error(erro);
                alert("Erro ao carregar interesses do banco.");
                return;
            }

            interessesAtendenteBanco.forEach((item, index) => {
                const classeTipo = classeTipoInteresse(item.tipo);
                const textoTipo = textoTipoInteresse(item.tipo);

                const statusTexto = item.status || "Pendente";
                const status = statusTexto.toLowerCase();

                const classeStatus =
                    status.includes("cancel") ? "cancelado" :
                    status.includes("conclu") ? "concluido" : "pendente";

                const tr = document.createElement("tr");

                tr.innerHTML = `
                    <td>${item.nome || ""}</td>

                    <td>
                        <span class="tipo ${classeTipo}">
                            ${textoTipo}
                        </span>
                    </td>

                    <td>${item.descricao || ""}</td>

                    <td>
                        <span class="${classeStatus}">
                            ${statusTexto}
                        </span>
                    </td>

                    <td>${item.dataSolicitacao || ""}</td>

                    <td>
                        <div class="dropdown-actions">
                            <button class="btn-acoes" type="button" onclick="toggleActions(this)">
                                Ações ▼
                            </button>

                            <div class="actions-menu hidden">
                                <button type="button" onclick="abrirModalInteresse('status', ${index})">
                                    Editar status
                                </button>

                                <button type="button" onclick="abrirModalInteresse('descricao', ${index})">
                                    Editar descrição
                                </button>

                                <button type="button" onclick="abrirModalInteresse('tipo', ${index})">
                                    Editar tipo
                                </button>

                                <button type="button" onclick="removerInteresse(${item.id})">
                                    Remover
                                </button>
                            </div>
                        </div>
                    </td>
                `;

                tbody.appendChild(tr);
            });
        }

                function pesquisarInteressesAtendente() {
            const input = document.getElementById("searchInteressesAtendente");
            const tbody = document.getElementById("listaInteressesAtendente");

            if (!input || !tbody) return;

            input.addEventListener("input", function () {
                const termo = this.value.toLowerCase();

                tbody.querySelectorAll("tr").forEach(tr => {
                    tr.style.display = tr.textContent.toLowerCase().includes(termo) ? "" : "none";
                });
            });
        }

                let usuarioEditandoIndex = null;
                let usuarioEditandoCampo = null;

                function abrirModalUsuario(campo, index) {
                    usuarioEditandoIndex = index;
                    usuarioEditandoCampo = campo;

                    const usuario = usuariosAtendenteBanco[index] || {};

                    const titulos = {
                        telefone: "Editar telefone",
                        email: "Editar email",
                        endereco: "Editar endereço"
                    };

                    document.getElementById("tituloEditarUsuario").textContent = titulos[campo] || "Editar";
                    document.getElementById("valorEditarUsuario").value = usuario[campo] || "";
                    document.getElementById("modalEditarUsuario").classList.remove("hidden");
                }

                function fecharModalUsuario() {
                    document.getElementById("modalEditarUsuario").classList.add("hidden");
                }

                async function salvarEdicaoUsuario() {
                    const valor = document.getElementById("valorEditarUsuario").value.trim();
                    if (!valor) {
                        alert("Preencha o campo.");
                        return;
                    }

                    const usuario = usuariosAtendenteBanco[usuarioEditandoIndex];
                    if (!usuario) return;

                    const resposta = await fetch(`/api/atendente/usuarios/${usuario.id}`, {
                        method: "PUT",
                        headers: {
                            "Content-Type": "application/json"
                        },
                        body: JSON.stringify({
                            campo: usuarioEditandoCampo,
                            valor: valor
                        })
                    });

                    if (!resposta.ok) {
                        const erro = await resposta.json().catch(() => null);
                        alert(erro?.mensagem || "Erro ao editar usuário.");
                        return;
                    }

                    fecharModalUsuario();
                    await carregarUsuariosAtendente();
                }

                let interesseEditandoIndex = null;
                let interesseEditandoCampo = null;

                function abrirModalInteresse(campo, index) {
                    interesseEditandoIndex = index;
                    interesseEditandoCampo = campo;

                    const item = interessesAtendenteBanco[index] || {};

                    const titulos = {
                        status: "Editar status",
                        descricao: "Editar descrição",
                        tipo: "Editar tipo"
                    };

                    document.getElementById("tituloEditarInteresse").textContent =
                        titulos[campo] || "Editar";

                    if (campo === "status") {
                        document.getElementById("areaEditarInteresse").innerHTML = `
                            <select id="valorEditarInteresse">
                                <option value="Pendente" ${item.status === "Pendente" ? "selected" : ""}>Pendente</option>
                                <option value="Concluído" ${(item.status || "").toLowerCase().includes("conclu") ? "selected" : ""}>Concluído</option>
                                <option value="Cancelado" ${(item.status || "").toLowerCase() === "cancelado" ? "selected" : ""}>Cancelado</option>
                            </select>
                        `;
                    } else if (campo === "tipo") {
                        document.getElementById("areaEditarInteresse").innerHTML = `
                            <select id="valorEditarInteresse">
                                <option value="Doador" ${(item.tipo || "").toLowerCase() === "doador" ? "selected" : ""}>Doador</option>
                                <option value="Receptor" ${(item.tipo || "").toLowerCase() === "receptor" ? "selected" : ""}>Receptor</option>
                                <option value="Ambos" ${(item.tipo || "").toLowerCase() === "ambos" ? "selected" : ""}>Ambos</option>
                            </select>
                        `;
                    } else {
                        document.getElementById("areaEditarInteresse").innerHTML = `
                            <input type="text" id="valorEditarInteresse" value="${item.descricao || ""}" placeholder="Nova descrição">
                        `;
                    }

                    document.getElementById("modalEditarInteresse").classList.remove("hidden");
                }

                function fecharModalInteresse() {
                    document.getElementById("modalEditarInteresse").classList.add("hidden");
                }

                async function salvarEdicaoInteresse() {
                    const valorEl = document.getElementById("valorEditarInteresse");
                    const valor = valorEl ? valorEl.value.trim() : "";

                    if (!valor) {
                        alert("Preencha o campo.");
                        return;
                    }

                    const interesse = interessesAtendenteBanco[interesseEditandoIndex];
                    if (!interesse) return;

                    const resposta = await fetch(`/api/atendente/interesses/${interesse.id}`, {
                        method: "PUT",
                        headers: {
                            "Content-Type": "application/json"
                        },
                        body: JSON.stringify({
                            campo: interesseEditandoCampo,
                            valor: valor
                        })
                    });

                    if (!resposta.ok) {
                        const erro = await resposta.json().catch(() => null);
                        alert(erro?.mensagem || "Erro ao editar interesse.");
                        return;
                    }

                    fecharModalInteresse();
                    await carregarInteressesAtendente();
                }

                async function removerInteresse(id) {
                    if (!confirm("Deseja remover este interesse?")) return;

                    const resposta = await fetch(`/api/atendente/interesses/${id}`, {
                        method: "DELETE"
                    });

                    if (!resposta.ok) {
                        const erro = await resposta.json().catch(() => null);
                        alert(erro?.mensagem || "Erro ao remover interesse.");
                        return;
                    }

                    await carregarInteressesAtendente();
                }

                document.addEventListener("DOMContentLoaded", function () {
            const tipoUsuario = localStorage.getItem("tipoUsuario");

           // if (tipoUsuario !== "atendente") {
               // window.location.href = "/Home/loginadmin";
               // return;
            //}

            const email = localStorage.getItem("atendenteEmail");
            const emailText = document.getElementById("atendenteEmailText");

            if (email && emailText) {
                emailText.textContent = email;
            }

            showSection("usuarios");
        carregarUsuariosAtendente();
        carregarInteressesAtendente();
        pesquisarUsuariosAtendente();
        pesquisarInteressesAtendente();

        });

    </script>

