@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Cadastro - Conecta++</title>
    <link rel="stylesheet" href="/css/cadastro.css">
</head>
<body>

    <main class="tela">
        <section class="card cadastro-card" id="etapaCadastro">
            <h1>Faça seu cadastro</h1>

            <form id="formCadastro">
                <input type="text" id="nome" placeholder="Nome completo">
                <input type="email" id="email" placeholder="E-mail">
                <input type="tel" id="telefone" placeholder="Telefone">
                <input type="text" id="cpf" placeholder="CPF">

                <input type="text" id="cep" placeholder="CEP">
                <input type="text" id="numero" placeholder="Número">
                <input type="text" id="rua" placeholder="Rua" readonly>
                <input type="text" id="bairro" placeholder="Bairro" readonly>
                <input type="text" id="cidade" placeholder="Cidade" readonly>
                <input type="text" id="estado" placeholder="Estado" readonly>

                <input type="date" id="dataNascimento">

                <button type="submit" class="btn-cadastrar">Cadastrar</button>
            </form>
        </section>

        <section class="card escolha-card hidden" id="etapaEscolha">
            <h1>O que deseja fazer?</h1>

            <div class="botoes-escolha">
                <button type="button" class="btn-opcao" onclick="selecionarOpcao('doar')">
                    Quero doar
                </button>

                <button type="button" class="btn-opcao" onclick="selecionarOpcao('receber')">
                    Quero receber doação
                </button>

                <button type="button" class="btn-opcao" onclick="selecionarOpcao('ambos')">
                    Ambos
                </button>
            </div>
        </section>

        <section class="card mensagem-card hidden" id="etapaMensagem">
            <div class="icone-sucesso">✓</div>

            <h1>Cadastro realizado com sucesso!</h1>

            <p>
                O Sistema de Apoio ao Idoso agradece seu cadastro.<br><br>
                A ONG entrará em contato com você via WhatsApp para mais informações.
            </p>
        </section>
    </main>
    <section class="card necessidade-card hidden" id="etapaNecessidade">
        <h1>Qual é a sua necessidade?</h1>

        <textarea id="necessidadeTexto" placeholder="Escreva aqui sua necessidade"></textarea>

        <button type="button" class="btn-opcao" onclick="irParaSucesso()">
            Continuar
        </button>
    </section>
    <script>

        document.addEventListener("DOMContentLoaded", function () {

            const formCadastro = document.getElementById("formCadastro");

            const etapaCadastro = document.getElementById("etapaCadastro");
            const etapaEscolha = document.getElementById("etapaEscolha");
            const etapaNecessidade = document.getElementById("etapaNecessidade");
            const etapaMensagem = document.getElementById("etapaMensagem");
            let cadastroAtual = null;
            let opcaoCadastro = "";

            /* ========================================= */
            /* CAMPOS */
            /* ========================================= */

            const cepInput = document.getElementById("cep");

            const ruaInput = document.getElementById("rua");
            const bairroInput = document.getElementById("bairro");
            const cidadeInput = document.getElementById("cidade");
            const estadoInput = document.getElementById("estado");

            /* ========================================= */
            /* BUSCAR CEP */
            /* ========================================= */

            async function buscarCep(cepBruto) {

                const cep = cepBruto.replace(/\D/g, "");

                if (cep.length !== 8) {
                    return;
                }

                try {

                    const resposta = await fetch(
                        `https://viacep.com.br/ws/${cep}/json/`
                    );

                    if (!resposta.ok) {
                        throw new Error("Erro ao buscar CEP");
                    }

                    const data = await resposta.json();

                    if (data.erro) {
                        alert("CEP não encontrado.");
                        return;
                    }

                    ruaInput.value = data.logradouro || "";
                    bairroInput.value = data.bairro || "";
                    cidadeInput.value = data.localidade || "";
                    estadoInput.value = data.uf || "";

                } catch (erro) {

                    console.error(erro);

                    alert("Erro ao buscar CEP.");

                }
            }

            cepInput.addEventListener("blur", function () {
                buscarCep(this.value);
            });

            /* ========================================= */
            /* CADASTRO */
            /* ========================================= */

            formCadastro.addEventListener("submit", function (event) {

                event.preventDefault();

                const nome = document.getElementById("nome").value.trim();

                const email = document.getElementById("email").value.trim();

                const telefone = document.getElementById("telefone").value.trim();

                const cpf = document.getElementById("cpf").value.trim();

                const cep = document.getElementById("cep").value.trim();

                const numero = document.getElementById("numero").value.trim();

                const rua = ruaInput.value.trim();

                const bairro = bairroInput.value.trim();

                const cidade = cidadeInput.value.trim();

                const estado = estadoInput.value.trim();

                const dataNascimento = document
                    .getElementById("dataNascimento")
                    .value;

                if (
                    !nome ||
                    !telefone ||
                    !cpf ||
                    !cep ||
                    !numero
                ) {

                    alert("Preencha todos os campos.");
                    return;
                }

                /* ========================================= */
                /* ENDEREÇO */
                /* ========================================= */

                const enderecoCompleto =
                    `${rua}, ${numero} - ${bairro}, ${cidade}/${estado}`;

                /* ========================================= */
                /* SALVAR USUÁRIOS */
                /* ========================================= */

                cadastroAtual = {

                    nome,
                    email,
                    telefone,
                    cpf,

                    endereco: enderecoCompleto,

                    dataNascimento

                };

                etapaCadastro.classList.add("hidden");

                etapaEscolha.classList.remove("hidden");

            });

            /* ========================================= */
            /* ESCOLHER OPÇÃO */
            /* ========================================= */

            window.selecionarOpcao = function (opcao) {

                opcaoCadastro = opcao;

                etapaEscolha.classList.add("hidden");

                etapaNecessidade.classList.remove("hidden");

            };

            /* ========================================= */
            /* FINALIZAR */
            /* ========================================= */

            window.irParaSucesso = async function () {

                const necessidade = document
                    .getElementById("necessidadeTexto")
                    .value
                    .trim();

                if (!necessidade) {

                    alert("Escreva sua necessidade.");

                    return;
                }

                if (!cadastroAtual) {

                    alert("Cadastro não encontrado.");

                    return;
                }

                /* ========================================= */
                /* INTERESSES */
                /* ========================================= */

                const resposta = await fetch("/Home/Cadastro", {
                    method: "POST",
                    headers: {
                        "Content-Type": "application/json"
                    },
                    body: JSON.stringify({
                        nome: cadastroAtual.nome,
                        email: cadastroAtual.email || null,
                        telefone: cadastroAtual.telefone.replace(/\D/g, ""),
                        cpf: cadastroAtual.cpf.replace(/\D/g, ""),
                        endereco: cadastroAtual.endereco,
                        cidade: cadastroAtual.cidade,
                        estado: cadastroAtual.estado,
                        dataNascimento: cadastroAtual.dataNascimento,
                        tipoParticipacao: opcaoCadastro,
                        necessidade: necessidade
                    })
                });

                if (!resposta.ok) {
                    const erro = await resposta.json().catch(() => null);
                    alert(erro?.mensagem || "Erro ao salvar cadastro.");
                    return;
                }

                const resultado = await resposta.json().catch(() => ({ sucesso: true }));

                if (resultado.sucesso === false) {
                    alert(resultado.mensagem || "Erro ao salvar cadastro.");
                    return;
                }

                /* ========================================= */
                /* LIMPAR */
                /* ========================================= */

                cadastroAtual = null;
                opcaoCadastro = "";

                /* ========================================= */
                /* TELA SUCESSO */
                /* ========================================= */

                etapaNecessidade.classList.add("hidden");

                etapaMensagem.classList.remove("hidden");

            };

        });

    </script>

</body>
</html>
